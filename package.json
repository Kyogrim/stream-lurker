{
  "name": "stream-lurker",
  "version": "0.14.0-beta",
  "description": "Standalone desktop application to check and automatically lurk in Twitch & Kick streams with adblock extension support.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "package": "electron-builder build --win --dir",
    "package-linux": "electron-builder build --linux --dir",
    "dist": "electron-builder build --win",
    "dist-linux": "electron-builder build --linux",
    "release": "electron-builder build --win --publish always",
    "release-linux": "electron-builder build --linux --publish always"
  },
  "keywords": [
    "twitch",
    "kick",
    "lurk",
    "streamer",
    "adblock",
    "desktop-app"
  ],
  "author": "Stream Lurker Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.streamlurker.app",
    "productName": "Stream Lurker",
    "electronFuses": {
      "grantFileProtocolExtraPrivileges": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kyogrim",
        "repo": "stream-lurker",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "main/**/*.js",
      "index.html",
      "style.css",
      "renderer.js",
      "src/**/*.js",
      "icon.ico",
      "package.json"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fflate": "0.8.3"
  }
}
